# ── Copy this file to ".env" and fill in the values ──────────────────────────

# Server
PORT=3000
# Public origin of the site (used for OAuth callbacks and share links).
# Local dev: http://localhost:3000   Production: https://your-domain.com
BASE_URL=http://localhost:3000
# Secret used to sign session cookies. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production: the server refuses to boot if this is unset, left at
# the placeholder, or shorter than 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string
# Set to "production" when deployed behind HTTPS (enables secure cookies + HSTS).
NODE_ENV=development
# Log verbosity: debug | info | warn | error | silent. Logs are JSON, one object
# per line, on stdout (warn and above go to stderr). debug also logs every 2xx
# request. Defaults to info.
LOG_LEVEL=info

# ── Google OAuth (https://console.cloud.google.com/apis/credentials) ─────────
# Authorized redirect URI:  {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Discord OAuth (https://discord.com/developers/applications) ──────────────
# Redirect URI:  {BASE_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Google AdSense (optional; leave blank to hide ads) ───────────────────────
# LEAVE BLANK unless you have consent handling in place. Ad cookies are NOT
# "strictly necessary", so switching ads on creates obligations the current site
# does not meet: you need a prior-consent banner that gates the ad script, and
# for EEA/UK visitors Google requires a certified Consent Management Platform
# (a hand-rolled banner does not satisfy their EU user consent policy). The
# privacy policy in public/privacy.html also states that we run no advertising —
# update it before enabling this.
# Your publisher ID, e.g. ca-pub-1234567890123456
ADSENSE_CLIENT=
# A display ad slot ID from your AdSense dashboard, e.g. 1234567890
ADSENSE_SLOT=

# ── Rate limiting & shutdown (optional) ──────────────────────────────────────
# Per-IP HTTP limits. Defaults are generous for players and tight enough that
# nobody can mint sessions in a loop (each one writes a database row).
RATE_WINDOW_MS=900000
RATE_LIMIT_AUTH=30
RATE_LIMIT_API=300
# How long SIGTERM waits for in-flight games to drain before forcing the exit.
SHUTDOWN_GRACE_MS=10000
# Max simultaneous socket connections per signed-in identity. The per-event
# limits are per socket, so this is what stops one account multiplying them by
# opening more tabs. A real player uses one or two.
MAX_SOCKETS_PER_IDENTITY=6

# ── Data retention (optional) ────────────────────────────────────────────────
# Accounts untouched for this many months are deleted automatically, along with
# their ratings and match history. This backs the retention promise in
# public/privacy.html — if you change the number here, change it there too.
INACTIVE_PURGE_MONTHS=24
# How often the sweep runs. It also runs once at startup.
INACTIVE_PURGE_INTERVAL_MS=86400000
# Set to "false" to disable the sweep entirely. Only do this if you also remove
# the 24-month commitment from the privacy policy.
INACTIVE_PURGE=true

# ── Performance (optional) ───────────────────────────────────────────────────
# The party tier (~5.4k rows, ~21 MB) is loaded into memory at startup, turning
# the app's most expensive recurring operation — a synchronous SQLite pick that
# blocks the event loop for every room — from ~8 ms into ~0. Set to "false" to
# fall back to querying SQLite each round.
PRELOAD_PARTY=true
# Safety valve: skip the preload if a mis-set PARTY_MIN_POP would pull this many
# rows into RAM. Chaos is never preloaded — it is the entire pool.
PARTY_PRELOAD_MAX_ROWS=50000
# Landing-page leaderboard cache. Invalidated immediately whenever a ranked
# result is recorded, so this is only a backstop for out-of-band writes.
LEADERBOARD_TTL_MS=30000
# How often to log the event-loop-lag / memory metrics line.
METRICS_INTERVAL_MS=60000

# ── Ranked matchmaking (optional) ────────────────────────────────────────────
# A waiting ranked player accepts opponents within MM_START_WINDOW rating
# points, and that range grows by MM_GROWTH_PER_SEC for every second they wait,
# up to MM_MAX_WINDOW. Defaults: ±100 instantly, ±500 after 20s, effectively
# anyone after ~70s. Tighten START/GROWTH once you have enough players that
# matches are found quickly; loosen them while the ladder is thin.
MM_START_WINDOW=100
MM_GROWTH_PER_SEC=20
MM_MAX_WINDOW=1500
# Players with fewer than MM_PROVISIONAL_GAMES games have a rating that is still
# a guess, so they search this much wider from the moment they queue.
MM_PROVISIONAL_BONUS=150
MM_PROVISIONAL_GAMES=10
# How often waiting ranked queues are re-swept as their windows widen.
MM_TICK_MS=1000
# Give up and tell the player rather than spinning forever. 0 disables.
MM_RANKED_TIMEOUT_MS=180000

# ── Gameplay tuning (optional) ───────────────────────────────────────────────
ROUNDS_PER_GAME=5
GUESS_SECONDS=20
# Casual practice-bot difficulty, 0 (pushover) … 1 (tough). 0.5 = beatable.
BOT_SKILL=0.5
