# ── Copy this file to ".env" and fill in the values ──────────────────────────

# Server
PORT=3000
# Public origin of the site (used for OAuth callbacks and share links).
# Local dev: http://localhost:3000   Production: https://your-domain.com
BASE_URL=http://localhost:3000
# Secret used to sign session cookies. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production: the server refuses to boot if this is unset, left at
# the placeholder, or shorter than 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string
# Set to "production" when deployed behind HTTPS (enables secure cookies + HSTS).
NODE_ENV=development
# Log verbosity: debug | info | warn | error | silent. Logs are JSON, one object
# per line, on stdout (warn and above go to stderr). debug also logs every 2xx
# request. Defaults to info.
LOG_LEVEL=info

# ── Google OAuth (https://console.cloud.google.com/apis/credentials) ─────────
# Authorized redirect URI:  {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Discord OAuth (https://discord.com/developers/applications) ──────────────
# Redirect URI:  {BASE_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Google AdSense (optional; leave blank to hide ads) ───────────────────────
# Your publisher ID, e.g. ca-pub-1234567890123456
ADSENSE_CLIENT=
# A display ad slot ID from your AdSense dashboard, e.g. 1234567890
ADSENSE_SLOT=

# ── Rate limiting & shutdown (optional) ──────────────────────────────────────
# Per-IP HTTP limits. Defaults are generous for players and tight enough that
# nobody can mint sessions in a loop (each one writes a database row).
RATE_WINDOW_MS=900000
RATE_LIMIT_AUTH=30
RATE_LIMIT_API=300
# How long SIGTERM waits for in-flight games to drain before forcing the exit.
SHUTDOWN_GRACE_MS=10000

# ── Gameplay tuning (optional) ───────────────────────────────────────────────
ROUNDS_PER_GAME=5
GUESS_SECONDS=20
# Casual practice-bot difficulty, 0 (pushover) … 1 (tough). 0.5 = beatable.
BOT_SKILL=0.5
