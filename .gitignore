node_modules/
.env
*.log
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.DS_Store
*.gz

# Terraform — tfvars holds OAuth secrets, state holds the session secret.
.terraform/
# .terraform.lock.hcl
*.tfstate
*.tfstate.*
# Trailing * on purpose: "*.tfvars" only matches names ENDING in .tfvars, so an
# editor swapfile or a hand-made terraform.tfvars.bak — both full of the same
# OAuth secrets — sailed straight past it and showed up as untracked.
*.tfvars*
!*.tfvars.example
crash.log

.claude